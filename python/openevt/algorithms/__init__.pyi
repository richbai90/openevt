@final
class Tensor:
    """A channel-first ``(C, H, W)`` tensor generated from event data.

    ``to_numpy()`` returns a NumPy array of shape ``(channels, height,
    width)``, where channel 0 is positive polarity and channel 1 is
    negative polarity in dual-channel mode.
    """

    def width(self) -> int: ...
    def height(self) -> int: ...
    def channels(self) -> int: ...
    def is_dual(self) -> bool: ...
    def at(self, channel: int, x: int, y: int) -> float: ...
    def to_numpy(self) -> npt.NDArray[np.float64]: ...

@final
class BaseTimeSurface:
    """Per-pixel last-event timestamps, optionally split by polarity."""

    def __new__(cls, width: int, height: int) -> BaseTimeSurface: ...
    def to_tensor(self, dual: bool) -> Tensor: ...
    def update(self, x: int, y: int, p: bool, ts: int) -> None: ...
    def get(self, x: int, y: int, p: bool) -> int: ...
    def width(self) -> int: ...
    def height(self) -> int: ...

@final
class LinearDecayTimeSurface:
    """Per-pixel values that decay linearly toward zero over time."""

    def __new__(
        cls, width: int, height: int, decay_time: int
    ) -> LinearDecayTimeSurface: ...
    def to_tensor(self, dual: bool) -> Tensor: ...
    def update(self, x: int, y: int, p: bool, ts: int) -> None: ...
    def decay_to(self, ts: int) -> None: ...
    def get(self, x: int, y: int, p: bool) -> float: ...
    def timestamp(self, x: int, y: int, p: bool) -> int: ...
    def width(self) -> int: ...
    def height(self) -> int: ...

@final
class ExponentialDecayTimeSurface:
    """Per-pixel values that decay exponentially toward zero over time."""

    def __new__(cls, width: int, height: int, tau: int) -> ExponentialDecayTimeSurface: ...
    def to_tensor(self, dual: bool) -> Tensor: ...
    def update(self, x: int, y: int, p: bool, ts: int) -> None: ...
    def decay_to(self, ts: int) -> None: ...
    def get(self, x: int, y: int, p: bool) -> float: ...
    def timestamp(self, x: int, y: int, p: bool) -> int: ...
    def width(self) -> int: ...
    def height(self) -> int: ...

@final
class Histogram:
    """Per-pixel event counts, optionally split by polarity."""

    def __new__(cls, width: int, height: int) -> Histogram: ...
    def add(self, x: int, y: int, p: bool) -> None: ...
    def count(self, x: int, y: int, p: bool) -> int: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def to_tensor(self, dual: bool) -> Tensor: ...

@final
class IntegralImage:
    """A summed-area table of per-pixel event counts."""

    def __new__(cls, width: int, height: int) -> IntegralImage: ...
    def add(self, x: int, y: int, p: bool) -> None: ...
    def integrate(self) -> None: ...
    def value(self, x: int, y: int, p: bool) -> int: ...
    def rect_sum(self, x0: int, y0: int, x1: int, y1: int, p: bool) -> int: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def to_tensor(self, dual: bool) -> Tensor: ...

@final
class BaseTimeSurfaceTransformer:
    """Builds a BaseTimeSurface from a batch of events."""

    def __new__(cls, width: int, height: int) -> BaseTimeSurfaceTransformer: ...
    def transform(self, events: npt.NDArray[Any]) -> BaseTimeSurface: ...

@final
class LinearDecayTimeSurfaceTransformer:
